# Virtual environment (each computer makes its own)
.venv/

# Python cache files
__pycache__/
*.pyc
.pytest_cache/

# Local database and secrets (never commit these)
*.db
.env

# Login token secret (made automatically on a laptop)
.secret_key

# Front end: installed libraries and build output (made again by npm)
frontend/node_modules/
frontend/dist/
